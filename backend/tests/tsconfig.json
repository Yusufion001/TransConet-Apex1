{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist-tests",
    "declaration": false,
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "./**/*.ts",
    "../src/**/*.ts",
    "../generated/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../dist-tests"
  ]
}
